# Server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trao-interview-prep
SESSION_SECRET=replace-with-a-long-random-value
CLIENT_ORIGIN=http://localhost:3000

# Company research limits
RESEARCH_MAX_PAGES=8
RESEARCH_MAX_DEPTH=2
RESEARCH_MAX_RESPONSE_BYTES=2097152
RESEARCH_MAX_TOTAL_BYTES=8388608
RESEARCH_REQUEST_TIMEOUT_MS=8000
RESEARCH_MIN_REQUEST_INTERVAL_MS=500
RESEARCH_MAX_RETRIES=2
RESEARCH_RETRY_BASE_DELAY_MS=300
RESEARCH_RETRY_MAX_DELAY_MS=2000
RESEARCH_MAX_REDIRECTS=5
RESEARCH_MAX_CRAWL_DELAY_MS=10000

# Public interview research limits (no provider credentials are required for tests)
INTERVIEW_SEARCH_MAX_QUERIES=6
INTERVIEW_SEARCH_MAX_RESULTS_PER_QUERY=5
INTERVIEW_RESEARCH_MAX_SOURCES=8
INTERVIEW_RESEARCH_MAX_CONTENT_BYTES=2097152

# LLM generation settings. No vendor adapter is bundled; configure only when an adapter is supplied.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_RESEARCH_CONTEXT_MAX_BYTES=65536
LLM_RESEARCH_CONTEXT_MAX_SOURCES=12
